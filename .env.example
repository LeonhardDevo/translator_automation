# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@localhost/ai_translation_db

# JWT Configuration (REQUIRED — must be at least 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Security settings
API_RATE_LIMIT=100/hour
MAX_FILE_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xlsx,pptx,txt,csv,json,xml,jpg,jpeg,png,gif,webp
SECURE_COOKIES=true

# Translation-specific settings
# Comma-separated Google AI Studio (Gemini) API keys
GEMINI_API_KEYS=
